{
  "name": "learn-claude-code",
  "private": true,
  "type": "module",
  "description": "依据 Claude Code 2.1.88 sourcemap 还原源码的工程解读，辅以独立版本实验",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node site/build.ts",
    "serve": "node site/serve.ts",
    "check": "node site/build.ts --check",
    "typecheck": "npx -y -p typescript@5.9.3 -p @types/node@22 tsc -p tsconfig.json",
    "setup:source": "node scripts/setup-sourcemap.mjs",
    "map:generate": "node scripts/engineering-map.mjs --write"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@types/node": "^22.20.5",
    "markdown-it": "14.1.0",
    "shiki": "3.13.0"
  }
}
